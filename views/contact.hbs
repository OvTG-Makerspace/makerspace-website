<section class="contact">
    <div class="container">
        <div class="contact-hero">
            <h2>Kontakt</h2>

            <form action="https://formtorch.com/f/ifwpryaprv" method="POST" data-validate-form novalidate>

                <div class="form-row">
                    <div class="form-group">
                        <label for="name">Name</label>
                        <input type="text" id="name" name="name">
                        <p class="field-error" data-field-error="name" hidden></p>
                    </div>

                    <div class="form-group">
                        <label for="email">E-Mail</label>
                        <input type="email" id="email" name="email" required>
                        <p class="field-error" data-field-error="email" hidden></p>
                    </div>
                </div>

                <div class="form-group full-width">
                    <label for="message">Nachricht</label>
                    <textarea id="message" name="message" required></textarea>
                    <p class="field-error" data-field-error="message" hidden></p>
                </div>

                <div class="form-group checkbox-group">
                    <label>
                        <input type="checkbox" name="datenschutz" required>
                        <span>
                            Ich bestätige die Datenschutzerklärung und bin damit einverstanden, dass meine Daten zum Zwecke der Kontaktaufnahme gespeichert und verwendet werden.
                            <a href="/impressum">Datenschutzerklärung</a>
                        </span>
                    </label>
                    <p class="field-error" data-field-error="datenschutz" hidden></p>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn">
                        Senden
                    </button>
                </div>

            </form>

        </div>
    </div>
</section>
